PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Optional: set to use MongoDB instead of local JSON file store
# MONGO_URI=mongodb://localhost:27017/voice_feedback
# Optional: Google Cloud Speech-to-Text (service account JSON path)
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
# Optional: switch local upload dir to S3/GCS in production (see ARCHITECTURE.md)
# Cloudinary (persists uploads after deploy — required for production)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
STORAGE_MODE=local
UPLOAD_DIR=./uploads
MAX_AUDIO_MB=10
MAX_DURATION_SEC=300
FRONTEND_URL=http://localhost:5173
